{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/engine/cli.py\" guard-command --format claude --role designer"
          }
        ]
      },
      {
        "matcher": "mcp__.*(merge_pull_request|auto_merge|merge_pr|pull_request_review|approve_pull_request|approve_pr|issue|label).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.harness/engine/cli.py\" guard-command --format claude --role designer"
          }
        ]
      }
    ]
  }
}
